# Template do "ambiente de teste" local (spec 010, seção 8) — a mesma imagem Docker que vai
# pra produção, rodando na sua máquina, apontando pro Mongo Atlas / Azure Blob Storage de
# TESTE (nunca produção). Copie para `.env` (não versionado) e preencha:
#   cp docker-compose.example.env .env

NODE_ENV=production
PORT=8080

# Cluster/Atlas Project de TESTE (ADR-009 em memory/decisions.md) — mesmas credenciais já
# usadas pelos testes e2e hoje, nunca as de produção.
MONGODB_URI=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Mesma Storage Account de sempre (ADR-003), container de TESTE.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=product-images-test

# Same-origin: a própria URL onde o container roda localmente.
FRONTEND_URL=http://localhost:8080
